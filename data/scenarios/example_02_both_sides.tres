[gd_resource type="Resource" script_class="PackingScenario" format=3]

[ext_resource type="Script" path="res://core/packing/packing_scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://core/packing/batch.gd" id="2_batch"]
[ext_resource type="Resource" path="res://data/legends/example_legend.tres" id="8_legend"]
[ext_resource type="Resource" path="res://data/cargo/example_beam.tres" id="4_beam"]
