[gd_scene format=3]

[ext_resource type="Script" path="res://ui/packing/round_summary.gd" id="1_summary"]

[sub_resource type="StyleBoxFlat" id="panel_style"]
bg_color = Color(0.16, 0.18, 0.24, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
