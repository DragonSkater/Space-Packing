text = "HOW TO PACK"

[node name="Controls" type="Label" parent="Column/Margins/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "• Tap the top of CARGO, or drag it to a door, to give the crane a piece.
• Tap a lit door to move the crane's piece there.
• Swipe left or right to slide a piece along its row. Slide it back out of a door to unload it.
• Swipe up or down to turn a piece a quarter turn.
• Tap a piece in the hull to work on it. Tap empty space to go back to the crane's piece.
• Tap CARGO while the crane holds a piece to put it back.
• Every slide and turn costs a move. Press Done, then launch."
autowrap_mode = 3

[node name="UpcomingTitle" type="Label" parent="Column/Margins/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "UPCOMING (placeholder launches until the contracts of milestone 6)"
